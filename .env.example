# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key — full DB access, bypasses RLS. Never expose to the client.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Resend (https://resend.com) — used to email the admin when a new lead comes in
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM_EMAIL=
LEAD_NOTIFICATION_TO_EMAIL=

# Public site URL, used for metadata/OG tags/sitemap generation
NEXT_PUBLIC_SITE_URL=http://localhost:3000
